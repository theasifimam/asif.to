NODE_ENV=development
PORT=5000

# Media Library (local storage is the only V1 provider)
ASSET_STORAGE_PROVIDER=local
ASSET_MAX_FILE_SIZE_MB=100
# Optional absolute origin for generated asset URLs, e.g. https://api.asif.to
PUBLIC_STORAGE_URL=

JWT_SECRET=password@123
JWT_REFRESH_SECRET=1d
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
OTP_EXPIRY_MINUTES=10
COOKIE_EXPIRE_DAYS=7
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=465
EMAIL_USER=noreply@asif.to
EMAIL_PASSWORD="fakepassword"
EMAIL_FROM="asif <noreply@asif.to>"
ADMIN_NOTIFY_EMAIL=admin@asif.to

API_PORT=5000
WEB_PORT=3000
ADMIN_PORT=3001

DEV_API_URL=http://localhost:5000
PROD_API_URL=https://api.asif.to

DEV_CLIENT_URL=http://localhost:3000
PROD_CLIENT_URL=http://157.245.108.229:3000

SERVER_IP="157.245.108.229"


LIVE_KEY_ID =sdfsdfsdaf
LIVE_KEY_SECRET =sdfasdfasdf


TWILIO_RECOVERY="abcdbevdjlksdfjslk"
TWILIO_ACC_SID="abcdkdjfladjflajsdflk"
TWILIO_AUTH_TOKEN="abcdeflkjaflkdjfkl"
TWILIO_PHONE_NUMBER="+1 333333333333"
TWILIO_SERVICE_SID="jfsdlkajfsldkfjlaksdjflkasdjflkj"

# Client-side variables
NEXT_PUBLIC_API_URL=https://asif.to
PROD_API_URL=https://api.asif.to
PROD_CLIENT_URL=https://asif.to


# Recommended: base64-encode the complete downloaded service-account JSON file.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Add the JSON file's client_email as a Full user of the property below.
GSC_SERVICE_ACCOUNT_BASE64=paste-the-single-line-base64-value-here
# Raw one-line JSON is also supported but is easier to break through .env quoting.
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

GSC_SITE_URL=sc-domain:asif.to
GSC_INITIAL_SYNC_DAYS=480
# Google Analytics Data API. The GSC service account is reused when these
# credential fields are blank, provided it has Viewer access to the GA4 property.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
# Dedicated random value used to pseudonymize first-party visitor/session IDs.
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret
# Shared only between the Next.js web server and this API. Generate a separate
# random value; never expose it with a NEXT_PUBLIC_ prefix.
AUTH_INTERNAL_SECRET=
# Deployment-level monetization master switch. Keep false until AdSense approval.
ADS_MASTER_ENABLED=false
# Optional server-side fallback for the public AdSense client ID.
ADSENSE_CLIENT_ID=

# Jobs synchronization. Set false to keep all imports manual. The scheduler also
# expires published jobs whose expiresAt has passed.
JOB_SYNC_ENABLED=true
# Bootstrap and sync the curated no-key public UAE-capable feeds. Set false to
# opt out; disabling a source later in admin is preserved across restarts.
JOB_DEFAULT_PUBLIC_SOURCES_ENABLED=true
# Optional deployment-managed registry. `npm run seed:job-sources` registers
# sources without fetching jobs. Store credential values separately.
JOB_SOURCE_REGISTRY_JSON=[]
# Provider credentials are referenced by name from Job Sources, for example:
# JOBS_VENDOR_API_TOKEN=

# Dedicated Communications / contact enquiry mailbox
EMAIL_SUPPORT_USER=support@asif.to
EMAIL_SUPPORT_PASSWORD=
EMAIL_SUPPORT_FROM="asif.to Support <support@asif.to>"
EMAIL_LOGO_URL=https://asif.to/logo.png
# EMAIL_HOST and EMAIL_PORT are shared; ADMIN_NOTIFY_EMAIL receives contact alerts.

# Countries jobs are accepted for: comma-separated ISO codes from AE,SA,QA,KW,BH,OM.
# Unset (or no valid code) means every Gulf country. AE alone restores UAE-only imports.
JOB_COUNTRIES=AE,SA,QA,KW,BH,OM
# Emergency brake: false sends every import to the review queue, even from trusted sources.
JOB_AUTO_PUBLISH=true
# Source sync worker. Sources are synced in parallel, but at most JOB_SYNC_PER_PROVIDER at once
# per ATS provider (they share rate limits). A tick stops starting sources after JOB_SYNC_TICK_MINUTES
# and defers the rest to the next 15-minute tick.
JOB_SYNC_CONCURRENCY=6
JOB_SYNC_PER_PROVIDER=2
JOB_SYNC_MAX_PER_TICK=300
JOB_SYNC_TICK_MINUTES=14
# Workday sources: postings read per Gulf search term, and detail fetches per sync.
JOB_WORKDAY_MAX_PER_SEARCH=400
JOB_WORKDAY_MAX_JOBS=1500
# Career-site (JSON-LD) crawler: politeness and safety limits per source. A sync fails, keeping existing
# jobs, when a sitemap lists more job URLs than MAX_URLS or most pages cannot be read.
JOB_JSONLD_DELAY_MS=500
JOB_JSONLD_MAX_URLS=1500
JOB_JSONLD_MAX_SITEMAPS=25
JOB_JSONLD_MAX_PAGE_BYTES=2000000

# Company discovery (finds new Gulf employers' public ATS boards and creates job sources)
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_HOURS=6
DISCOVERY_PROBE_BATCH=800
DISCOVERY_PROBE_CONCURRENCY=8
DISCOVERY_MAX_VERIFICATIONS_PER_RUN=200
DISCOVERY_MAX_COMPANIES_PER_RUN=60

# Imported jobs that no sync has seen for this many days are expired (e.g. their source was
# disabled). Admin-protected statuses are skipped. 0 disables.
JOB_STALE_EXPIRY_DAYS=30
