# Recommended: base64-encode the complete downloaded service-account JSON file.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Add the JSON file's client_email as a Full user of the property below.
GSC_SERVICE_ACCOUNT_BASE64=paste-the-single-line-base64-value-here
# Raw one-line JSON is also supported but is easier to break through .env quoting.
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

GSC_SITE_URL=sc-domain:asif.to
GSC_INITIAL_SYNC_DAYS=480
# Google Analytics Data API. The GSC service account is reused when these
# credential fields are blank, provided it has Viewer access to the GA4 property.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
# Dedicated random value used to pseudonymize first-party visitor/session IDs.
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret
# Shared only between the Next.js web server and this API. Generate a separate
# random value; never expose it with a NEXT_PUBLIC_ prefix.
AUTH_INTERNAL_SECRET=
