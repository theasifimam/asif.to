NEXT_PUBLIC_STORAGE_URL="http://localhost:5000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
# GA4 web data stream measurement ID (for example: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Deployment-level web safety switch. Database controls cannot override false.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADS_ENABLED=false

# Keep true for placeholder-only verification; false permits requests in production.
NEXT_PUBLIC_ADSENSE_TEST_MODE=true

# Auth.js OAuth (server-only; never prefix these with NEXT_PUBLIC_).
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Same random value configured as AUTH_INTERNAL_SECRET on the Express API.
AUTH_INTERNAL_SECRET=
# Optional server-only API override. Defaults to NEXT_PUBLIC_API_URL.
AUTH_API_URL=http://localhost:5000/api/v1
# Optional verified author profiles. Leave unset until the real URLs are known;
# unset values are omitted from Person.sameAs structured data.
NEXT_PUBLIC_AUTHOR_GITHUB_URL=
NEXT_PUBLIC_AUTHOR_LINKEDIN_URL=
NEXT_PUBLIC_AUTHOR_PORTFOLIO_URL=
