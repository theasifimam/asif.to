everse-a-string","description":"Write a function that returns the supplied string in reverse order. Preserve spaces and punctuation.","keywords":["Strings","Algorithms"],"course":"javascript","category":"Easy Practice","technology":"javascript","priority":7},{"id":"practice:javascript:remove-duplicates","type":"practice","title":"Remove Duplicates From Array","url":"/practice/javascript/remove-duplicates","description":"Return a new array containing each value only once, without changing the input array.","keywords":["Arrays","Algorithms"],"course":"javascript","category":"Easy Practice","technology":"javascript","priority":7},{"id":"practice:javascript:character-frequency","type":"practice","title":"Character Frequency","url":"/practice/javascript/character-frequency","description":"Count how often every character occurs and return an object of character-to-count pairs.","keywords":["Strings","Objects"],"course":"javascript","category":"Medium Practice","technology":"javascript","priority":7},{"id":"practice:javascript:flatten-an-array","type":"practice","title":"Flatten an Array","url":"/practice/javascript/flatten-an-array","description":"Flatten a nested array of arbitrary depth without mutating it.","keywords":["Arrays","Algorithms"],"course":"javascript","category":"Medium Practice","technology":"javascript","priority":7},{"id":"practice:javascript:debounce-function","type":"practice","title":"Debounce Function","url":"/practice/javascript/debounce-function","description":"Implement debounce so a function runs only after calls have stopped for the given delay.","keywords":["Functions","Async/Await"],"course":"javascript","category":"Hard Practice","technology":"javascript","priority":7},{"id":"practice:html:accessible-contact-form","type":"practice","title":"Accessible Contact Form","url":"/practice/html/accessible-contact-form","description":"Create a labelled contact form with appropriate input types, autocomplete values, and accessible validation hints.","keywords":["Accessibility","Forms"],"course":"html","category":"Easy Practice","technology":"html","priority":7},{"id":"practice:css:responsive-card","type":"practice","title":"Responsive Card","url":"/practice/css/responsive-card","description":"Style a card that remains readable and balanced from a narrow phone to a desktop.","keywords":["Responsive Design"],"course":"css","category":"Easy Practice","technology":"css","priority":7},{"id":"practice:css:flexbox-navbar","type":"practice","title":"Flexbox Navbar","url":"/practice/css/flexbox-navbar","description":"Use Flexbox to align a brand and navigation links, then adapt the layout on small screens.","keywords":["Flexbox","Responsive Design"],"course":"css","category":"Easy Practice","technology":"css","priority":7},{"id":"practice:css:css-grid-layout","type":"practice","title":"CSS Grid Layout","url":"/practice/css/css-grid-layout","description":"Build a responsive grid whose cards automatically wrap without fixed breakpoint columns.","keywords":["Grid","Responsive Design"],"course":"css","category":"Medium Practice","technology":"css","priority":7},{"id":"practice:web:accordion","type":"practice","title":"Accordion","url":"/practice/web/accordion","description":"Create an accessible accordion whose button controls a collapsible answer.","keywords":["DOM","Events"],"course":"web","category":"Easy Practice","technology":"web","priority":7},{"id":"practice:web:modal","type":"practice","title":"Modal","url":"/practice/web/modal","description":"Open and close a modal with buttons and the Escape key while keeping its semantics accessible.","keywords":["DOM","Events"],"course":"web","category":"Medium Practice","technology":"web","priority":7},{"id":"practice:web:tabs","type":"practice","title":"Tabs","url":"/practice/web/tabs","description":"Build keyboard-friendly tabs that reveal one associated panel at a time.","keywords":["DOM","Components"],"course":"web","category":"Medium Practice","technology":"web","priority":7},{"id":"practice:web:todo-list","type":"practice","title":"Todo List","url":"/practice/web/todo-list","description":"Build a todo list that adds, completes, and removes items without reloading the page.","keywords":["DOM","Events"],"course":"web","category":"Hard Practice","technology":"web","priority":7},{"id":"practice:react:counter","type":"practice","title":"Counter","url":"/practice/react/counter","description":"Build a counter with increment, decrement, and reset controls.","keywords":["State","Hooks"],"course":"react","category":"Easy Practice","technology":"react","priority":7},{"id":"practice:react:accordion","type":"practice","title":"Accordion","url":"/practice/react/accordion","description":"Create a reusable controlled accordion section with an accessible toggle.","keywords":["Components","State"],"course":"react","category":"Easy Practice","technology":"react","priority":7},{"id":"practice:react:todo-list","type":"practice","title":"Todo List","url":"/practice/react/todo-list","description":"Create a todo list with immutable state updates and stable item keys.","keywords":["State","Forms"],"course":"react","category":"Medium Practice","technology":"react","priority":7},{"id":"practice:react:controlled-form","type":"practice","title":"Controlled Form","url":"/practice/react/controlled-form","description":"Build a controlled profile form and render a submitted summary.","keywords":["Forms","State"],"course":"react","category":"Medium Practice","technology":"react","priority":7},{"id":"practice:react:search-filter","type":"practice","title":"Search Filter","url":"/practice/react/search-filter","description":"Filter a list as the user types and show a useful empty state.","keywords":["State","Performance"],"course":"react","category":"Medium Practice","technology":"react","priority":7},{"id":"practice:react:use-debounce-hook","type":"practice","title":"useDebounce Hook","url":"/practice/react/use-debounce-hook","description":"Implement a reusable useDebounce hook that cleans up its timeout when dependencies change.","keywords":["Hooks","Performance"],"course":"react","category":"Hard Practice","technology":"react","priority":7},{"id":"practice:nextjs:client-counter","type":"practice","title":"Next.js Client Counter","url":"/practice/nextjs/client-counter","description":"Use a client-side React component in a Next.js page. The browser sandbox demonstrates client behavior only.","keywords":["Components"],"course":"nextjs","category":"Easy Practice","technology":"nextjs","priority":7},{"id":"practice:nextjs:dynamic-route-links","type":"practice","title":"Dynamic Route Links","url":"/practice/nextjs/dynamic-route-links","description":"Render product links using Next.js Link. Use the preview navigator to go Back, Forward, Refresh, or enter a route.","keywords":["Routing"],"course":"nextjs","category":"Medium Practice","technology":"nextjs","priority":7},{"id":"practice:nextjs:optimized-navigation","type":"practice","title":"Client Navigation","url":"/practice/nextjs/optimized-navigation","description":"Create a small navigation header with Next.js Link and active-looking styles.","keywords":["Pages","Routing"],"course":"nextjs","category":"Easy Practice","technology":"nextjs","priority":7}]}