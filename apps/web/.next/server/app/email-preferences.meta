{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/email-preferences/layout,_N_T_/email-preferences/page,_N_T_/email-preferences"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/email-preferences/__PAGE__",
    "/email-preferences",
    "/@modal/__DEFAULT__",
    "/_index",
    "/_head"
  ]
}